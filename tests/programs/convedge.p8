%import textio
%import conv
%import strings

; the edges of the number and string routines that some targets have in assembly
main {
    str buffer = "?" * 20

    sub start() {
        txt.print(conv.str_ub0(7))
        txt.spc()
        txt.print(conv.str_ub(0))
        txt.spc()
        txt.print(conv.str_ub(255))
        txt.spc()
        txt.print(conv.str_b(-128))
        txt.spc()
        txt.print(conv.str_uw0(42))
        txt.spc()
        txt.print(conv.str_uw(65535))
        txt.spc()
        txt.print(conv.str_w(-32768))
        txt.nl()
        txt.print(conv.str_l(-2147483647))
        txt.spc()
        txt.print(conv.str_l(1000000))
        txt.spc()
        txt.print(conv.str_l(0))
        txt.nl()
        txt.print(conv.str_ubhex($0a))
        txt.spc()
        txt.print(conv.str_uwhex($beef))
        txt.spc()
        txt.print(conv.str_ulhex($0123abcd))
        txt.nl()
        txt.print_uw(conv.str2uword("0"))
        txt.spc()
        txt.print_uw(conv.str2uword("65535"))
        txt.spc()
        txt.print_uw(conv.str2uword("123abc"))
        txt.spc()
        txt.print_uw(conv.str2uword(""))
        txt.spc()
        txt.print_w(conv.str2word("-1234"))
        txt.spc()
        txt.print_w(conv.str2word("+77"))
        txt.nl()
        txt.print_uwhex(conv.hex2uword("$fFe0"), true)
        txt.spc()
        txt.print_uwhex(conv.hex2uword("1a"), true)
        txt.spc()
        txt.print_uwhex(conv.hex2uword("12g4"), true)
        txt.spc()
        txt.print_uwhex(conv.hex2uword("@1"), true)
        txt.nl()
        txt.print_ub(strings.length(""))
        txt.spc()
        txt.print_ub(strings.length("twelve chars"))
        txt.spc()
        txt.print_ub(strings.copy("copied", buffer))
        txt.print(buffer)
        txt.spc()
        txt.print_ub(strings.ncopy("longer than four", buffer, 4))
        txt.print(buffer)
        txt.spc()
        txt.print_ub(strings.ncopy("gone", buffer, 0))
        txt.print_ub(strings.length(buffer))
        txt.spc()
        txt.print_ub(strings.ncopy("ab", buffer, 9))
        txt.print(buffer)
        txt.nl()
        txt.print_b(strings.compare("abc", "abc"))
        txt.spc()
        txt.print_b(strings.compare("abc", "abd"))
        txt.spc()
        txt.print_b(strings.compare("abd", "abc"))
        txt.spc()
        txt.print_b(strings.compare("ab", "abc"))
        txt.spc()
        txt.print_b(strings.compare("abc", "ab"))
        txt.spc()
        txt.print_b(strings.compare("", ""))
        txt.spc()
        txt.print_b(strings.compare("a", "\xe9"))
        txt.nl()
    }
}
